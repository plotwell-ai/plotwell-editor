# =====================================================
# PLOTWELL BACKEND - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env.development or .env.production and fill in your values
# NEVER commit .env files with real API keys!

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# AI Services
OPENAI_API_KEY=sk-your_openai_api_key
REPLICATE_API_TOKEN=r8_your_replicate_token
GROK_API_KEY=xai-your_grok_api_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Environment Settings
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Logging (development: debug, production: error)
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
DEBUG_AI=false

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PAID_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_PAID_YEARLY_PRICE_ID=price_your_yearly_price_id
STRIPE_ADDON_PROJECT_PRICE_ID=price_your_project_addon_monthly_id
STRIPE_ADDON_COLLABORATOR_PRICE_ID=price_your_collaborator_addon_monthly_id
STRIPE_ADDON_PROJECT_YEARLY_PRICE_ID=price_your_project_addon_yearly_id
STRIPE_ADDON_COLLABORATOR_YEARLY_PRICE_ID=price_your_collaborator_addon_yearly_id
STRIPE_ADDON_IMAGE_CREDITS_PRICE_ID=price_your_image_credits_addon_id

# Frontend URLs (comma-separated for CORS)
# First URL is used for redirects (Stripe, invitations, etc.)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Security Settings
ENABLE_HOT_RELOAD=true
ENABLE_DETAILED_ERRORS=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# IP Allowlist (optional - leave empty to allow all IPs)
ALLOWED_IPS=

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=plotwell

# Onboarding / Growth
# Controls how new users are onboarded:
#   freemium  → users get free plan (1 project, 1 doc, 5 AI actions) and upgrade when ready (default)
#   trial_7d  → users get a free trial of the paid plan for TRIAL_DAYS days
ONBOARDING_MODE=freemium 
TRIAL_DAYS=7

# Optional: Date simulation for testing (uncomment to use)
# SIMULATED_DATE="2025-10-02T18:11:00Z"

# Optional: Monitoring (uncomment to use)
# SENTRY_DSN=your_sentry_dsn
# DATADOG_API_KEY=your_datadog_key

